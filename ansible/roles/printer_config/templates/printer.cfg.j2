# ANSIBLE MANAGED — generated from inventory/. Edits here will be overwritten.
#   printer:  {{ printer_id }}
#   board:    Creality 4.2.2 (TMC2208 standalone, CH340 on USART1)
#   probe:    {{ printer.probe }}
#   dual Z:   {{ printer.dual_z }}
#
# Calibration results written here by SAVE_CONFIG must be promoted back into
# inventory/host_vars/{{ inventory_hostname }}.yml — see docs/10-iac.md.

[mcu]
serial: {{ device_path }}
restart_method: command

[printer]
kinematics: cartesian
max_velocity: {{ printer.velocity.max_velocity }}
max_accel: {{ printer.velocity.max_accel }}
max_z_velocity: {{ printer.velocity.max_z_velocity }}
max_z_accel: {{ printer.velocity.max_z_accel }}

[stepper_x]
step_pin: PB9
dir_pin: PC2
enable_pin: !PC3
microsteps: 16
rotation_distance: 40
endstop_pin: ^PA5
position_endstop: 0
position_max: {{ printer.bed_size }}
homing_speed: 50

[stepper_y]
step_pin: PB7
dir_pin: PB8
enable_pin: !PC3
microsteps: 16
rotation_distance: 40
endstop_pin: ^PA6
position_endstop: 0
position_max: {{ printer.bed_size }}
homing_speed: 50

{% if printer.dual_z %}
# Dual Z: two motors driven from the single Z output on the 4.2.2 via a
# Y-splitter. There is no second Z driver on this board, so this stays ONE
# [stepper_z] — no [stepper_z1], and Z_TILT_ADJUST is not possible. The gantry
# is levelled by hand. See CLAUDE.md.
{% endif %}
[stepper_z]
step_pin: PB5
dir_pin: !PB6
enable_pin: !PC3
microsteps: 16
rotation_distance: 8
{% if printer.probe == 'bltouch' %}
endstop_pin: probe:z_virtual_endstop
position_max: {{ printer.max_z }}
position_min: -5
{% else %}
# Stock mechanical Z endstop. Switches to the probe when
# `printer.probe` becomes `bltouch` in host_vars.
endstop_pin: ^PA7
position_endstop: 0.0
position_max: {{ printer.max_z }}
{% endif %}

[extruder]
step_pin: PB3
dir_pin: PB4
enable_pin: !PC3
microsteps: 16
rotation_distance: {{ printer.extruder.rotation_distance }}
nozzle_diameter: 0.400
filament_diameter: 1.750
max_extrude_only_distance: 100.0
heater_pin: PA1
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PC5
control: pid
pid_Kp: {{ printer.extruder.pid_kp }}
pid_Ki: {{ printer.extruder.pid_ki }}
pid_Kd: {{ printer.extruder.pid_kd }}
min_temp: 0
max_temp: {{ printer.extruder.max_temp }}

[heater_bed]
heater_pin: PA2
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PC4
control: pid
pid_Kp: {{ printer.bed.pid_kp }}
pid_Ki: {{ printer.bed.pid_ki }}
pid_Kd: {{ printer.bed.pid_kd }}
min_temp: 0
max_temp: {{ printer.bed.max_temp }}

[fan]
pin: PA0

# The stock DWIN LCD is not supported by Klipper. No [display] section by design;
# a dark screen after flashing is expected.

{% if printer.probe == 'bltouch' %}
[bltouch]
sensor_pin: ^PB1
control_pin: PB0
x_offset: {{ printer.probe_offsets.x }}
y_offset: {{ printer.probe_offsets.y }}
z_offset: {{ printer.probe_offsets.z }}
speed: 5
samples: 2
samples_result: median
probe_with_touch_mode: True
stow_on_each_sample: False

[safe_z_home]
home_xy_position: {{ (printer.bed_size / 2) | round(1) }}, {{ (printer.bed_size / 2) | round(1) }}
speed: 50
z_hop: 10
z_hop_speed: 5

[bed_mesh]
speed: 120
horizontal_move_z: 5
# Probe coordinates, bounded by the probe offsets so the nozzle stays on the bed.
mesh_min: 15, 15
mesh_max: {{ (printer.bed_size + printer.probe_offsets.x - 5) | round(0) | int }}, {{ (printer.bed_size + printer.probe_offsets.y - 5) | round(0) | int }}
probe_count: 5, 5
algorithm: bicubic
fade_start: 1.0
fade_end: 10.0
fade_target: 0

[screws_tilt_adjust]
screw1: 30, 30
screw1_name: front left
screw2: {{ printer.bed_size - 35 }}, 30
screw2_name: front right
screw3: {{ printer.bed_size - 35 }}, {{ printer.bed_size - 35 }}
screw3_name: back right
screw4: 30, {{ printer.bed_size - 35 }}
screw4_name: back left
horizontal_move_z: 10
speed: 100
screw_thread: CW-M4
{% else %}
# No probe fitted on this machine. Bed levelling is manual (paper/feeler), and
# Z offset is set with Z_OFFSET_APPLY_ENDSTOP. Setting `printer.probe: bltouch`
# in host_vars adds [bltouch], [safe_z_home], [bed_mesh] and [screws_tilt_adjust]
# and switches [stepper_z] to the virtual endstop.
{% endif %}

{% if printer.runout_sensor %}
[filament_switch_sensor runout]
switch_pin: ^PA4
pause_on_runout: True
{% endif %}

{% if printer.input_shaper.enabled %}
[input_shaper]
shaper_freq_x: {{ printer.input_shaper.freq_x }}
shaper_freq_y: {{ printer.input_shaper.freq_y }}
shaper_type: {{ printer.input_shaper.type }}
{% endif %}

#####################################################################
#  Macros
#####################################################################

[gcode_macro START_PRINT]
gcode:
{% raw %}    {% set BED_TEMP = params.BED_TEMP|default(60)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(200)|float %}
{% endraw %}    M140 S{% raw %}{BED_TEMP}{% endraw %}
    G90
    M190 S{% raw %}{BED_TEMP}{% endraw %}
    G28
{% if printer.probe == 'bltouch' %}
    BED_MESH_PROFILE LOAD=default
{% endif %}
    M109 S{% raw %}{EXTRUDER_TEMP}{% endraw %}
    G92 E0
    G1 X0.1 Y20 Z0.3 F5000.0
    G1 X0.1 Y{{ printer.bed_size - 35 }}.0 Z0.3 F1500.0 E15
    G1 X0.4 Y{{ printer.bed_size - 35 }}.0 Z0.3 F5000.0
    G1 X0.4 Y20 Z0.3 F1500.0 E30
    G92 E0
    G1 Z2.0 F3000

[gcode_macro END_PRINT]
gcode:
    G91
    G1 E-2 F2700
    G1 E-2 Z0.2 F2400
    G1 X5 Y5 F3000
    G90
{% raw %}    G1 Z{printer.toolhead.position.z + 10} F3000
    G1 X0 Y{printer.toolhead.axis_maximum.y - 10} F3000
{% endraw %}    M106 S0
    M104 S0
    M140 S0
    M84 X Y E

[gcode_macro CANCEL_PRINT]
rename_existing: BASE_CANCEL_PRINT
gcode:
    CLEAR_PAUSE
    TURN_OFF_HEATERS
    M106 S0
    BASE_CANCEL_PRINT

[gcode_macro PAUSE]
rename_existing: BASE_PAUSE
variable_extrude: 1.0
gcode:
{% raw %}    {% set E = printer["gcode_macro PAUSE"].extrude|float %}
{% endraw %}    SAVE_GCODE_STATE NAME=PAUSE_state
    BASE_PAUSE
    G91
    G1 E-{% raw %}{E}{% endraw %} F2100
    G1 Z10
    G90
    G1 X0 Y0 F6000

[gcode_macro RESUME]
rename_existing: BASE_RESUME
gcode:
{% raw %}    {% set E = printer["gcode_macro PAUSE"].extrude|float %}
{% endraw %}    G91
    G1 E{% raw %}{E}{% endraw %} F2100
    RESTORE_GCODE_STATE NAME=PAUSE_state MOVE=1
    BASE_RESUME

{% if printer.dual_z %}
[gcode_macro Z_ALIGN_REMINDER]
description: Dual-Z gantry cannot self-level on a 4.2.2 — this is the manual procedure
gcode:
    {% raw %}{ action_respond_info(
      "Dual Z on one driver: both screws are mechanically locked together.\n"
      "To re-align: disable steppers (M84), lower the gantry by hand until both\n"
      "sides bottom out against the frame stops, then re-home. Do this after any\n"
      "power-off where a screw may have been turned by hand.") }{% endraw %}
{% endif %}

[virtual_sdcard]
path: {{ klipper_data }}/gcodes
on_error_gcode: CANCEL_PRINT

[pause_resume]
[display_status]
[exclude_object]
