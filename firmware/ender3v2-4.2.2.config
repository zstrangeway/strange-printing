# Klipper MCU firmware config — Creality 4.2.2 (Ender 3 V2)
#
# This is a FRAGMENT, not a full .config. `make olddefconfig` fills in every
# symbol not named here, so this file stays readable and survives Klipper
# version bumps that add new options.
#
# Build with: ansible-playbook playbooks/firmware.yml
#
# Why these values:
#   MACH_STM32F103          the MCU (a GD32F303 clone builds identically)
#   STM32_FLASH_START_7000  0x7000 = 28 KiB, where the stock Creality
#                           bootloader hands off
#   STM32_CLOCK_REF_8M      8 MHz crystal on this board
#   STM32F103_SERIAL_PA10_PA9  the CH340 is wired to USART1 — this board does
#                           NOT use native USB. Choosing a USB interface here
#                           produces firmware that never enumerates.
#   SERIAL_BAUD 250000      matches Klipper's default host-side baud
#
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_CLOCK_REF_8M=y
CONFIG_STM32F103_SERIAL_PA10_PA9=y
CONFIG_SERIAL=y
CONFIG_SERIAL_BAUD=250000
